<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KOA" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/koa_orange</item>
        <item name="colorPrimaryDark">@color/koa_wood2</item>
        <item name="colorAccent">@color/koa_amber</item>
        <item name="android:statusBarColor">@color/koa_wood2</item>
        <item name="android:navigationBarColor">@color/koa_wood2</item>
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:textColorPrimary">@color/koa_cream</item>
        <item name="android:textColorSecondary">@color/koa_muted</item>
        <item name="android:editTextBackground">@drawable/field_bg</item>
    </style>
    <style name="KoaDrawerBtn" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_ghost</item>
        <item name="android:textColor">@color/koa_cream</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:drawablePadding">14dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>
    <style name="KoaSectionLabel">
        <item name="android:textColor">@color/koa_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">2dp</item>
    </style>
</resources>
