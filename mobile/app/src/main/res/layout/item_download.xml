<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/field_bg">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dlName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/koa_cream"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/dlState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/koa_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/dlOpen"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_check"
        android:contentDescription="Apri" />

    <ImageButton
        android:id="@+id/dlDelete"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_trash"
        android:contentDescription="Elimina" />
</LinearLayout>
